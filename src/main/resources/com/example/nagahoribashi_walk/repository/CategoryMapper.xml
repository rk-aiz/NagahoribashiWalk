<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.nagahoribashi_walk.repository.CategoryMapper">

    <!-- resultMap を使って1対多をマッピング -->
    <resultMap id="navCategoryResultMap" type="com.example.nagahoribashi_walk.dto.NavCategory">
        <id property="id" column="category_id" />
        <result property="name" column="category_name" />
        <result property="displayOrder" column="category_display_order" />
        <collection property="subCategories" ofType="com.example.nagahoribashi_walk.dto.NavSubCategory">
            <id property="id" column="sub_category_id" />
            <result property="name" column="sub_category_name" />
            <result property="categoryId" column="category_id" />
            <result property="displayOrder" column="sub_category_display_order" />
        </collection>
    </resultMap>

    <resultMap id="adminCategoryRowResultMap" type="com.example.nagahoribashi_walk.dto.AdminCategoryRow">
        <id property="id" column="category_id" />
        <result property="name" column="category_name" />
        <result property="displayOrder" column="category_display_order" />
        <result property="isDefault" column="category_is_default" />
        <collection property="subCategories" ofType="com.example.nagahoribashi_walk.dto.AdminSubCategoryRow">
            <id property="id" column="sub_category_id" />
            <result property="name" column="sub_category_name" />
            <result property="categoryId" column="category_id" />
            <result property="displayOrder" column="sub_category_display_order" />
            <result property="isDefault" column="sub_category_is_default" />
        </collection>
    </resultMap>

    <!-- カテゴリナビゲーション用にcategoriesテーブルとsub_categoriesテーブルを全件取得 -->
    <select id="findAllNavCategories" resultMap="navCategoryResultMap">
        SELECT 
            c.id AS category_id, 
            c.name AS category_name, 
            c.display_order AS category_display_order,
            sc.id AS sub_category_id, 
            sc.name AS sub_category_name,
            sc.display_order AS sub_category_display_order
        FROM 
            categories c 
        LEFT JOIN
            sub_categories sc
        ON
            c.id = sc.category_id AND
            EXISTS (
                SELECT 1 FROM spots s
                WHERE s.sub_category_id = sc.id
                AND s.deleted_at IS NULL
            )
        ORDER BY
            c.display_order, sc.display_order
    </select>

    <!-- 管理者機能用にcategoriesテーブルとsub_categoriesテーブルを全件取得 -->
    <select id="findAllForAdmin" resultMap="adminCategoryRowResultMap">
        SELECT 
            c.id AS category_id, 
            c.name AS category_name, 
            c.display_order AS category_display_order,
            c.is_default AS category_is_default,
            sc.id AS sub_category_id, 
            sc.name AS sub_category_name,
            sc.display_order AS sub_category_display_order,
            sc.is_default AS sub_category_is_default
        FROM 
            categories c 
        LEFT JOIN
            sub_categories sc
        ON
            c.id = sc.category_id
        ORDER BY
            c.display_order, sc.display_order
    </select>

    <select id="findById" resultType="com.example.nagahoribashi_walk.dto.NavCategory">
        SELECT id, name FROM categories
        WHERE id = #{id}
    </select>

    <!-- サイドバー用にcategoriesテーブルを全件取得 -->
    <select id="findFlatAllNavCategories" resultType="com.example.nagahoribashi_walk.dto.NavCategory">
        SELECT 
            c.id, 
            c.name, 
            c.display_order
        FROM 
            categories c 
        ORDER BY
            c.display_order
    </select>
    
    
    <!-- 大谷記載 -->
    <!-- 新規追加 -->
    <insert id="insertCategory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories (name, display_order)
        VALUES (#{name}, #{displayOrder})
    </insert>


    <!-- 削除 -->
    <delete id="deleteCategory">
        DELETE FROM categories WHERE id = #{id}
    </delete>
   

</mapper>